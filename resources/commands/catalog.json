[
  {"id":"ls","name":"ls","summary":"列出目录内容","usage":"ls [选项] [路径]","example":"ls -lah\nls -l /etc","tags":["文件","目录"]},
  {"id":"cd","name":"cd","summary":"切换当前目录","usage":"cd [目录]","example":"cd ~\ncd /var/log\ncd -","tags":["文件","目录"]},
  {"id":"pwd","name":"pwd","summary":"显示当前工作目录","usage":"pwd","example":"pwd","tags":["文件","目录"]},
  {"id":"cp","name":"cp","summary":"复制文件或目录","usage":"cp [选项] 源 目标","example":"cp a.txt b.txt\ncp -r src/ dst/","tags":["文件"]},
  {"id":"mv","name":"mv","summary":"移动或重命名","usage":"mv [选项] 源 目标","example":"mv old.txt new.txt\nmv *.log /tmp/","tags":["文件"]},
  {"id":"rm","name":"rm","summary":"删除文件或目录","usage":"rm [选项] 文件…","example":"rm file.txt\nrm -rf build/","tags":["文件","危险"]},
  {"id":"mkdir","name":"mkdir","summary":"创建目录","usage":"mkdir [选项] 目录…","example":"mkdir -p a/b/c","tags":["文件","目录"]},
  {"id":"cat","name":"cat","summary":"连接并打印文件内容","usage":"cat [文件…]","example":"cat /etc/os-release","tags":["文件","查看"]},
  {"id":"less","name":"less","summary":"分页查看文件","usage":"less 文件","example":"less /var/log/syslog","tags":["文件","查看"]},
  {"id":"grep","name":"grep","summary":"按模式搜索文本","usage":"grep [选项] 模式 [文件…]","example":"grep -Rn \"TODO\" .\ngrep -i error app.log","tags":["搜索","文本"]},
  {"id":"find","name":"find","summary":"按条件查找文件","usage":"find 路径 [表达式]","example":"find . -name \"*.c\"\nfind /tmp -mtime -1","tags":["搜索","文件"]},
  {"id":"chmod","name":"chmod","summary":"修改文件权限","usage":"chmod 模式 文件…","example":"chmod +x script.sh\nchmod 644 file.txt","tags":["权限"]},
  {"id":"chown","name":"chown","summary":"修改所有者","usage":"chown 用户[:组] 文件…","example":"chown user:user file","tags":["权限"]},
  {"id":"ps","name":"ps","summary":"查看进程","usage":"ps [选项]","example":"ps aux\nps -ef | grep nginx","tags":["进程"]},
  {"id":"top","name":"top","summary":"实时查看进程与资源","usage":"top","example":"top\nhtop","tags":["进程","监控"]},
  {"id":"kill","name":"kill","summary":"向进程发信号","usage":"kill [-信号] PID","example":"kill -9 1234\nkillall firefox","tags":["进程"]},
  {"id":"df","name":"df","summary":"查看磁盘占用","usage":"df [选项]","example":"df -h","tags":["磁盘"]},
  {"id":"du","name":"du","summary":"查看目录占用空间","usage":"du [选项] [路径]","example":"du -sh *\ndu -h --max-depth=1","tags":["磁盘"]},
  {"id":"free","name":"free","summary":"查看内存使用","usage":"free [选项]","example":"free -h","tags":["内存"]},
  {"id":"tar","name":"tar","summary":"打包 / 解包归档","usage":"tar [选项] 归档 [文件…]","example":"tar -czvf a.tar.gz dir/\ntar -xzvf a.tar.gz","tags":["压缩"]},
  {"id":"curl","name":"curl","summary":"传输 URL 数据","usage":"curl [选项] URL","example":"curl -I https://example.com\ncurl -LO https://example.com/file","tags":["网络"]},
  {"id":"wget","name":"wget","summary":"下载文件","usage":"wget [选项] URL","example":"wget -c https://example.com/file","tags":["网络"]},
  {"id":"ssh","name":"ssh","summary":"远程安全登录","usage":"ssh [用户@]主机","example":"ssh user@192.168.1.10","tags":["网络","远程"]},
  {"id":"scp","name":"scp","summary":"远程复制文件","usage":"scp 源 目标","example":"scp file user@host:/path/","tags":["网络","远程"]},
  {"id":"systemctl","name":"systemctl","summary":"管理系统服务","usage":"systemctl 命令 单元","example":"systemctl status nginx\nsystemctl enable --now docker","tags":["服务"]},
  {"id":"journalctl","name":"journalctl","summary":"查看 systemd 日志","usage":"journalctl [选项]","example":"journalctl -u nginx -f\njournalctl -xe","tags":["日志","服务"]},
  {"id":"apt","name":"apt","summary":"Debian/Ubuntu 包管理","usage":"apt 子命令","example":"sudo apt update\nsudo apt install build-essential","tags":["包管理"]},
  {"id":"dnf","name":"dnf","summary":"Fedora/RHEL 包管理","usage":"dnf 子命令","example":"sudo dnf install gcc","tags":["包管理"]},
  {"id":"make","name":"make","summary":"按 Makefile 构建","usage":"make [目标]","example":"make\nmake clean","tags":["开发","构建"]},
